generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String
  locale       String    @default("de-DE")
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AppSettings {
  id                      Int      @id @default(1)
  currency                String   @default("EUR")
  defaultLocale           String   @default("de-DE")
  electricityPricePerKwh  Decimal  @default(0)
  calculationVersion      String   @default("1")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  email      String?
  note       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([name])
  @@index([archivedAt])
}

model Printer {
  id                    String             @id @default(cuid())
  name                  String
  manufacturer          String?
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  averagePowerWatts     Int
  note                  String?
  archivedAt            DateTime?
  components            PrinterComponent[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([name])
  @@index([archivedAt])
}

model Component {
  id                    String             @id @default(cuid())
  type                  String
  name                  String
  manufacturer          String?
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  note                  String?
  archivedAt            DateTime?
  printers              PrinterComponent[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([name])
  @@index([type])
  @@index([archivedAt])
}

model PrinterComponent {
  printerId   String
  componentId String
  printer     Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([printerId, componentId])
  @@index([componentId])
}

model Filament {
  id             String    @id @default(cuid())
  name           String
  manufacturer   String
  material       String
  color          String?
  purchasePrice  Decimal
  netWeightGrams Decimal
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
  @@index([manufacturer])
  @@index([material])
  @@index([archivedAt])
}
