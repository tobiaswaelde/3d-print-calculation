generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String
  locale       String    @default("de-DE")
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AppSettings {
  id                      Int      @id @default(1)
  currency                String   @default("EUR")
  defaultLocale           String   @default("de-DE")
  electricityPricePerKwh  Decimal  @default(0)
  calculationVersion      String   @default("1")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  email      String?
  note       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  printJobs   PrintJob[]

  @@index([name])
  @@index([archivedAt])
}

model Printer {
  id                    String             @id @default(cuid())
  name                  String
  manufacturer          String?
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  averagePowerWatts     Int
  note                  String?
  archivedAt            DateTime?
  components            PrinterComponent[]
  printJobs              PrintJob[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([name])
  @@index([archivedAt])
}

model Component {
  id                    String             @id @default(cuid())
  type                  String
  name                  String
  manufacturer          String?
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  note                  String?
  archivedAt            DateTime?
  printers              PrinterComponent[]
  usages                PrintComponentUsage[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([name])
  @@index([type])
  @@index([archivedAt])
}

model PrinterComponent {
  printerId   String
  componentId String
  printer     Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([printerId, componentId])
  @@index([componentId])
}

model Filament {
  id             String    @id @default(cuid())
  name           String
  manufacturer   String
  material       String
  color          String?
  purchasePrice  Decimal
  netWeightGrams Decimal
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  usages         PrintFilamentUsage[]

  @@index([name])
  @@index([manufacturer])
  @@index([material])
  @@index([archivedAt])
}

model PrintJob {
  id                   String                 @id @default(cuid())
  name                 String
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  printerId            String
  printer              Printer                @relation(fields: [printerId], references: [id], onDelete: Restrict)
  status               String                 @default("DRAFT")
  notes                String?
  totalDurationSeconds Int
  formulaVersion       String
  currency             String
  totalCost            Decimal
  completedAt          DateTime?
  archivedAt           DateTime?
  componentUsages      PrintComponentUsage[]
  filamentUsages       PrintFilamentUsage[]
  snapshot             PrintCostSnapshot?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([name])
  @@index([status, archivedAt])
  @@index([customerId])
  @@index([printerId])
  @@index([completedAt])
}

model PrintComponentUsage {
  id                       String    @id @default(cuid())
  printJobId               String
  printJob                 PrintJob  @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  componentId              String
  component                Component @relation(fields: [componentId], references: [id], onDelete: Restrict)
  componentType            String
  componentName            String
  purchasePrice            Decimal
  expectedLifetimeHours    Decimal
  hourlyRate               Decimal
  appliedDurationSeconds   Int
  lineCost                 Decimal
  createdAt                DateTime  @default(now())

  @@index([printJobId])
  @@index([componentId])
}

model PrintFilamentUsage {
  id                    String   @id @default(cuid())
  printJobId            String
  printJob              PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  filamentId            String
  filament              Filament @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  filamentName          String
  manufacturer          String
  material              String
  purchasePrice         Decimal
  netWeightGrams        Decimal
  costPerGram           Decimal
  usedGrams             Decimal
  lineCost              Decimal
  createdAt             DateTime @default(now())

  @@index([printJobId])
  @@index([filamentId])
}

model PrintCostSnapshot {
  id                        String   @id @default(cuid())
  printJobId                String   @unique
  printJob                  PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  electricityPricePerKwh    Decimal
  printerName               String
  printerPurchasePrice      Decimal
  printerExpectedLifetimeHours Decimal
  printerHourlyRate         Decimal
  printerPowerWatts         Int
  printerCost               Decimal
  componentCost             Decimal
  filamentCost              Decimal
  electricityCost           Decimal
  totalCost                 Decimal
  currency                  String
  formulaVersion            String
  calculatedAt              DateTime @default(now())
}
