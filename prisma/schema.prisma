generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String
  locale       String    @default("de-DE")
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AppSettings {
  id                      Int      @id @default(1)
  currency                String   @default("EUR")
  defaultLocale           String   @default("de-DE")
  electricityPricePerKwh  Decimal  @default(0)
  calculationVersion      String   @default("1")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
